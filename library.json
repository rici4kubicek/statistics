{
    "name": "Statistics",
    "version": "2.0.0",
    "description": "Implementation of simple statistics functionality for embedded systems, including an exponential smoothing filter, online linear regression and float-free integer modules (fixed-point EMA, mean accumulator, sliding-window regression, integer math helpers) for MCUs without FPU.",
    "keywords": "statistics, math, embedded, mean calculation, max determination, exponential smoothing, filter, linear regression, fixed point, integer, no fpu, cortex-m0, sliding window, clamp, map",
    "repository": {
        "type": "git",
        "url": "https://github.com/rici4kubicek/statistics.git"
    },
    "authors": [
        {
            "name": "Richard Kubíček",
            "email": "rici.kubicek@gmail.com",
            "url": "https://richardkubicek.com",
            "maintainer": true
        }
    ],
    "examples": [
        {
            "name": "Statistics ring buffer - min max mean variance stdev",
            "base": "example",
            "files": [
                "platformio.ini",
                "src/statistics/main.c",
                "scripts/run_native.py"
            ]
        },
        {
            "name": "Integer helpers - range mapping and clamping",
            "base": "example",
            "files": [
                "platformio.ini",
                "src/int_math/main.c",
                "scripts/run_native.py"
            ]
        },
        {
            "name": "Fixed-point exponential smoothing",
            "base": "example",
            "files": [
                "platformio.ini",
                "src/exponential_smoothing_i32/main.c",
                "scripts/run_native.py"
            ]
        },
        {
            "name": "Integer mean accumulator",
            "base": "example",
            "files": [
                "platformio.ini",
                "src/mean_accumulator_i32/main.c",
                "scripts/run_native.py"
            ]
        },
        {
            "name": "Integer sliding-window line fit",
            "base": "example",
            "files": [
                "platformio.ini",
                "src/window_regression_i32/main.c",
                "scripts/run_native.py"
            ]
        }
    ],
    "license": "MIT",
    "frameworks": "*",
    "platforms": "*"
}
